{
  "manifest_version": 3,
  "name": "LinkeMap",
  "version": "0.3.0",
  "description": "Importa le offerte di una ricerca LinkedIn Jobs e le mostra su una mappa.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "tabs", "scripting", "cookies"],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://nominatim.openstreetmap.org/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "LinkeMap",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  }
}
